# --- Database ---
DATABASE_URL=postgresql+psycopg://civicpulse:civicpulse@postgres:5432/civicpulse

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Triage provider selection: llm | ollama | rules | simulated ---
TRIAGE_PROVIDER=simulated

# --- Groq (used when TRIAGE_PROVIDER=llm) ---
GROQ_API_KEY=changeme
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (used when TRIAGE_PROVIDER=ollama) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# --- App ---
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=20
